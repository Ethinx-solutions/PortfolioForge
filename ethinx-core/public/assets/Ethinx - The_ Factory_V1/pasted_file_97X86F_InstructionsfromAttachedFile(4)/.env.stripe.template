# ETHINX STRIPE INTEGRATION - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual keys
# DO NOT commit .env to version control

# ============================================================================
# STRIPE CONFIGURATION (LIVE MODE)
# ============================================================================

# Your Stripe Secret Key (LIVE MODE - starts with sk_live_)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_actual_key_here

# Your Stripe Public Key (LIVE MODE - starts with pk_live_)
# Get from: https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLIC_KEY=pk_live_your_actual_key_here

# Stripe Webhook Secret (for handling events)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# PRODUCT CONFIGURATION
# ============================================================================

# Neural Recon Strike Price ID (from deployment)
REACT_APP_NEURAL_RECON_PRICE_ID=price_XXXXX

# Digital Originals Price IDs (from deployment)
REACT_APP_DIGITAL_ORIGINALS_STARTER_PRICE_ID=price_XXXXX
REACT_APP_DIGITAL_ORIGINALS_PROFESSIONAL_PRICE_ID=price_XXXXX
REACT_APP_DIGITAL_ORIGINALS_ULTIMATE_PRICE_ID=price_XXXXX

# Spark Product Price IDs (from deployment)
REACT_APP_SPARK_ENHANCED_PRICE_ID=price_XXXXX
REACT_APP_SPARK_TECHNICAL_BASELINE_PRICE_ID=price_XXXXX

# Add-on Price IDs (from deployment)
REACT_APP_BIO_SUITE_PRICE_ID=price_XXXXX
REACT_APP_THREE_HOUR_RUSH_PRICE_ID=price_XXXXX

# ============================================================================
# URL CONFIGURATION
# ============================================================================

# Backend API URL
REACT_APP_API_URL=http://localhost:3001

# Success redirect URL (after payment)
SUCCESS_URL=https://www.ethinx.solutions/success?session_id={CHECKOUT_SESSION_ID}

# Cancel redirect URL (if payment cancelled)
CANCEL_URL=https://www.ethinx.solutions/cancel

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Backend server port
PORT=3001

# Node environment
NODE_ENV=development

# ============================================================================
# LOGGING & DEBUG
# ============================================================================

# Enable debug logging
DEBUG=ethinx:*

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# SECURITY
# ============================================================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.ethinx.solutions

# JWT secret for session tokens
JWT_SECRET=your_jwt_secret_key_here

# ============================================================================
# GOOGLE CLOUD STORAGE
# ============================================================================

# GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# GCS Bucket name
GCS_BUCKET_NAME=ethinx-data-vault

# GCP Service Account Key (path or JSON)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================================================
# EMAIL CONFIGURATION (for confirmations)
# ============================================================================

# Email service (sendgrid, mailgun, smtp)
EMAIL_SERVICE=sendgrid

# SendGrid API key (if using SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key

# Email from address
EMAIL_FROM=noreply@ethinx.solutions

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

# Sentry DSN (for error tracking)
SENTRY_DSN=your_sentry_dsn

# Mixpanel token (for analytics)
MIXPANEL_TOKEN=your_mixpanel_token

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. STRIPE KEYS:
#    - Test keys start with pk_test_ and sk_test_
#    - Live keys start with pk_live_ and sk_live_
#    - Make sure you're using LIVE keys for production
#
# 2. PRICE IDs:
#    - Get from Stripe deployment script output
#    - Format: price_XXXXX
#    - Each product has a unique price ID
#
# 3. WEBHOOK SECRET:
#    - Used to verify Stripe webhook signatures
#    - Get from Stripe Dashboard > Webhooks
#    - Format: whsec_XXXXX
#
# 4. SECURITY:
#    - NEVER commit .env to version control
#    - Add .env to .gitignore
#    - Use different keys for dev/staging/production
#    - Rotate keys regularly
#
# 5. LOCAL DEVELOPMENT:
#    - Use test keys (pk_test_, sk_test_) for development
#    - Use live keys (pk_live_, sk_live_) for production only
#    - Use Stripe CLI for local webhook testing
#
