    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ETHINX - Street-Smart Founder Tools</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --ethinx-primary: #D4AF37;\n      --ethinx-background: #000000;\n      --ethinx-text-primary: #F5F5F5;\n      --ethinx-border-radius: 0px;\n    }\n\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n      border-radius: var(--ethinx-border-radius);\n    }\n\n    body {\n      background-color: var(--ethinx-background);\n      color: var(--ethinx-text-primary);\n      font-family: 'Rajdhani', sans-serif;\n      line-height: 1.6;\n    }\n\n    header {\n      background-color: var(--ethinx-background);\n      border-bottom: 2px solid var(--ethinx-primary);\n      padding: 16px 24px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n\n    .logo {\n      font-family: 'Orbitron', sans-serif;\n      font-size: 24px;\n      font-weight: bold;\n      color: var(--ethinx-primary);\n      text-transform: uppercase;\n    }\n\n    h1, h2, h3 {\n      font-family: 'Orbitron', sans-serif;\n      font-weight: bold;\n      text-transform: uppercase;\n      color: var(--ethinx-primary);\n      letter-spacing: 0.05em;\n    }\n\n    h1 { font-size: 64px; }\n    h2 { font-size: 48px; }\n    h3 { font-size: 36px; }\n\n    .btn {\n      background-color: var(--ethinx-primary);\n      color: var(--ethinx-background);\n      border: none;\n      padding: 12px 24px;\n      font-family: 'Orbitron', sans-serif;\n      font-weight: bold;\n      text-transform: uppercase;\n      cursor: pointer;\n      transition: all 0.3s ease;\n    }\n\n    .btn:hover {\n      background-color: #E8C547;\n      transform: scale(1.02);\n   