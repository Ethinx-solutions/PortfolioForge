  "css_template": {
    "description": "Copy this CSS into your stylesheet for visual parity",
    "content": ":root {\n  --ethinx-primary: #D4AF37;\n  --ethinx-background: #000000;\n  --ethinx-text-primary: #F5F5F5;\n  --ethinx-text-secondary: #D4AF37;\n  --ethinx-border-radius: 0px;\n}\n\nbody {\n  background-color: var(--ethinx-background);\n  color: var(--ethinx-text-primary);\n  font-family: 'Rajdhani', sans-serif;\n}\n\nh1, h2, h3, h4, h5, h6 {\n  font-family: 'Orbitron', sans-serif;\n  font-weight: bold;\n  text-transform: uppercase;\n  color: var(--ethinx-text-secondary);\n  letter-spacing: 0.05em;\n}\n\nbutton, .btn {\n  background-color: var(--ethinx-primary);\n  color: var(--ethinx-background);\n  border: none;\n  border-radius: var(--ethinx-border-radius);\n  font-family: 'Orbitron', sans-serif;\n  font-weight: bold;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\nbutton:hover, .btn:hover {\n  background-color: #E8C547;\n  transform: scale(1.02);\n}\n\nbutton:active, .btn:active {\n  background-color: #C9A02F;\n  transform: scale(0.98);\n}\n\n* {\n  border-radius: var(--ethinx-border-radius) !important;\n}\n"
  },
