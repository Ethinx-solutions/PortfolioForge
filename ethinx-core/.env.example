# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Infrastructure
# Local Docker redis:  docker-compose up -d  (or)  redis-server
# REDIS_URL=redis://localhost:6379
# Upstash (serverless, rediss://):
# REDIS_URL=rediss://default:<password>@<host>:6379
# Redis is OPTIONAL in development (in-memory fallback keeps the dashboard up).
# The BullMQ worker requires it for background jobs.

# External APIs
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
API_KEYS=key1,key2